# =============================================================================
# Database Configuration
# =============================================================================
MYSQL_ROOT_PASSWORD=your_secure_root_password
DB_NAME=whatsticket
DB_USER=whatsuser
DB_PASS=your_secure_database_password

# Project-specific databases
PROJECT1_ROOT_PASSWORD=project1_secure_password
PROJECT1_DB_NAME=project1_audit
PROJECT1_DB_USER=project1_user
PROJECT1_DB_PASSWORD=project1_secure_password

PROJECT2_ROOT_PASSWORD=project2_secure_password
PROJECT2_DB_NAME=project2_audit
PROJECT2_DB_USER=project2_user
PROJECT2_DB_PASSWORD=project2_secure_password

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_minimum_32_characters_long

# =============================================================================
# Server Configuration
# =============================================================================
PORT=8080
BACKEND_URL=https://api.whatsapp.yourcompany.com
FRONTEND_URL=https://app.whatsapp.yourcompany.com

# =============================================================================
# WhatsApp Business API Configuration
# =============================================================================
WA_BUSINESS_TOKEN=your_whatsapp_business_api_token
WA_BUSINESS_ID=your_whatsapp_business_id
WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# =============================================================================
# RPA Configuration
# =============================================================================
1MAP_USERNAME=your_1map_username
1MAP_PASSWORD=your_1map_password
BROWSER_POOL_SIZE=10
MAX_CONCURRENT_AUDITS=5
SCREENSHOT_PATH=/app/screenshots
PHOTO_PATH=/app/photos

# =============================================================================
# Queue Configuration
# =============================================================================
QUEUE_CONCURRENCY=10

# =============================================================================
# Scaling Configuration
# =============================================================================
RPA_REPLICAS=4
QUEUE_REPLICAS=2
BACKEND_REPLICAS=2

# =============================================================================
# Monitoring Configuration
# =============================================================================
GRAFANA_PASSWORD=your_grafana_admin_password

# =============================================================================
# SSL Configuration
# =============================================================================
SSL_EMAIL=your_email@yourcompany.com
SSL_DOMAINS=api.whatsapp.yourcompany.com,app.whatsapp.yourcompany.com

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_optional

# =============================================================================
# File Upload Configuration
# =============================================================================
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# =============================================================================
# Email Configuration (Optional)
# =============================================================================
MAIL_HOST=smtp.yourcompany.com
MAIL_PORT=587
MAIL_USER=your_email@yourcompany.com
MAIL_PASS=your_email_password
MAIL_FROM=noreply@yourcompany.com

# =============================================================================
# Security Configuration
# =============================================================================
CORS_ORIGIN=https://app.whatsapp.yourcompany.com
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000
SESSION_TIMEOUT=1800000  # 30 minutes in milliseconds

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MAX_SIZE=10485760  # 10MB
LOG_MAX_FILES=10

# =============================================================================
# Backup Configuration
# =============================================================================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # At 2:00 AM every day