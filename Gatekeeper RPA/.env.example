# Application Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/gatekeeper_rpa
DATABASE_SSL=true

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# WhatsApp Integration
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_BASE_URL=https://api.whatsapp.com/v1
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_URL=https://your-domain.com/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# WhatiTicket Configuration
WHATITICKET_VERSION=latest
WHATITICKET_DATABASE=postgresql
WHATITICKET_REDIS=true
WHATITICKET_ENCRYPTION_KEY=your-encryption-key-here-32-chars-long
WHATITICKET_JWT_SECRET=your-jwt-secret-here-32-chars-long
WHATITICKET_WEBHOOK_URL=https://your-domain.com/api/whatiTicket/webhook
WHATITICKET_VERIFY_TOKEN=your-whatiTicket-verify-token

# 1Map Integration
ONEMAP_BASE_URL=https://1map.example.com
ONEMAP_USERNAME=your-1map-username
ONEMAP_PASSWORD=your-1map-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE_MB=10
UPLOAD_PATH=./uploads

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Monitoring and Analytics
ENABLE_METRICS=true
METRICS_PORT=9090

# Security Headers
HELMET_CSP_DEFAULT_SRC="'self'"
HELMET_CSP_SCRIPT_SRC="'self' 'unsafe-inline'"
HELMET_CSP_STYLE_SRC="'self' 'unsafe-inline'"
HELMET_CSP_IMG_SRC="'self' data: https:"
HELMET_CSP_CONNECT_SRC="'self' https: wss:"