<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Don't backup shared preferences with sensitive data -->
        <exclude domain="sharedpref" path="auth_prefs.xml" />
        <exclude domain="sharedpref" path="security_prefs.xml" />

        <!-- Don't backup databases with sensitive data -->
        <exclude domain="database" path="fibreflow.db" />
        <exclude domain="database" path="fibreflow.db-shm" />
        <exclude domain="database" path="fibreflow.db-wal" />

        <!-- Don't backup cache directories -->
        <exclude domain="cache" />
    </cloud-backup>

    <device-transfer>
        <!-- Include most data for device transfer -->
        <include domain="file" />
        <include domain="sharedpref" />

        <!-- Exclude sensitive data from device transfer -->
        <exclude domain="sharedpref" path="auth_prefs.xml" />
        <exclude domain="sharedpref" path="security_prefs.xml" />
        <exclude domain="database" path="fibreflow.db" />
    </device-transfer>
</data-extraction-rules>