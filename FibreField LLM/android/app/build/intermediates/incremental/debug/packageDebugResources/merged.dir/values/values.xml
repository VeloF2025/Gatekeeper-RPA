<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <bool name="enable_analytics">true</bool>
    <bool name="enable_crash_reporting">true</bool>
    <color name="accent">#FF4081</color>
    <color name="divider">#BDBDBD</color>
    <color name="icons">#FFFFFF</color>
    <color name="primary">#1976D2</color>
    <color name="primary_dark">#1565C0</color>
    <color name="primary_light">#42A5F5</color>
    <color name="primary_text">#212121</color>
    <color name="secondary_text">#757575</color>
    <string name="app_name">FibreField Technician</string>
    <string name="camera">Camera</string>
    <string name="cancel">Cancel</string>
    <string name="gallery">Gallery</string>
    <string name="location">Location</string>
    <string name="login">Login</string>
    <string name="logout">Logout</string>
    <string name="network_error">Network Error</string>
    <string name="no">No</string>
    <string name="ok">OK</string>
    <string name="retry">Retry</string>
    <string name="settings">Settings</string>
    <string name="sync">Sync</string>
    <string name="welcome_message">Welcome to FibreField Technician App</string>
    <string name="yes">Yes</string>
    <style name="Theme.FibreField" parent="Theme.AppCompat.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/primary</item>
        
        <item name="android:statusBarColor" ns1:targetApi="l">@color/primary_dark</item>
        
    </style>
    <style name="Theme.FibreField.Dialog" parent="Theme.FibreField">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="Theme.FibreField.Fullscreen" parent="Theme.FibreField">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="Theme.FibreField.Starting" parent="Theme.FibreField">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>